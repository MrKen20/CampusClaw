# CampusClaw 迭代 1 配置示例 —— 复制为 .env 后填写真实值
# 注意：.env 不入库、不进镜像（.gitignore / .dockerignore 已排除）

# 会话密钥（必填，无默认值；缺失时 api 启动失败）
# 生成建议：openssl rand -hex 32
SESSION_SECRET=

# 数据库（api 使用普通账号连接；root 口令由 db 容器随机生成，不在此下发）
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=

# 预置账号口令（必填，bcrypt 哈希入库；账号：teacher_a / student_a1 / student_b1）
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# 上传大小上限（字节，默认 1048576 = 1MB；超限返回 413）
MAX_UPLOAD_BYTES=1048576

# 会话有效期（小时，默认 24）
SESSION_TTL_HOURS=24

# 登录失败限流：窗口内连续失败达到阈值后锁定（响应仍与口令错误同形）
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=300

# 对外访问端口（唯一映射到宿主的端口，默认 8080；冲突时修改此项）
WEB_PORT=8080

# ===== 第 4 课：知识库检索（嵌入网关 / 对话网关 / Qdrant）=====
# 嵌入网关（必填；BASE_URL 只到 /v1，程序自行接上 /embeddings；密钥只在登录后显示，勿入库）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048

# 对话网关（必填；问答仅在检索命中后调用）
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=course-chat

# Qdrant 向量库（Compose 内部网络，不映射宿主端口）
QDRANT_URL=http://qdrant:6333

# 切分与检索参数（带文档化默认值）
CHUNK_AUTO_MAX_CHARS=800
CHUNK_AUTO_OVERLAP=80
VECTOR_SCORE_THRESHOLD=0.25
RRF_K=60
ASK_TOP_K=4
